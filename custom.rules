alert icmp $EXTERNAL_NET any -> $HOME_NET any (itype:0; icode:0; msg:"Unauthorized Incoming ICMP Reply Detected"; classtype:attempted-recon; sid:1000001; rev:2;)
alert icmp $HOME_NET any -> $EXTERNAL_NET any (itype:8; msg:"Possible ICMP Flood / Ping Sweep Detected - Excessive Outgoing Echo Requests"; threshold:type threshold, track by_src, count 20, seconds 1; classtype:attempted-dos; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"PDF file transfer detected"; content:"|25 50 44 46 2D|"; classtype:policy-violation; sid:1000003; rev:1;)
alert http any any -> $HOME_NET any (file.data; content:"|25 50 44 46 2D|"; depth:5; content:"/JavaScript"; nocase; distance:0; within:8192; flow:to_client,established; msg:"SuspiciousPDF: embedded JavaScript detected"; classtype:policy-violation; sid:1000007; rev:2;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible EXE File Transfer Detected (MZ Header)"; flow:to_client,established; file.data; content:"|4D 5A|"; depth:2; content:"This program cannot be run in DOS mode"; distance:0; within:200; classtype:policy-violation; sid:1000011; rev:1;)
alert tcp $HOME_NET any -> any 25 (flow:to_server,established; pcre:"/4\d{3}(\s|-)?\d{4}(\s|-)?\d{4}(\s|-)?\d{4}/"; msg:"Sensitive Data Exposure: Possible Visa Card Number Detected in Cleartext"; classtype:policy-violation; sid:1000009; rev:2;)
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"Phishing Attempt: Suspicious PayPal DomainDetected"; dns_query; content:"paypal.com"; nocase; isdataat:1,relative; classtype:trojan-activity; priority:2; sid:1000010; rev:1;)
